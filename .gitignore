# Virtual environment
color/
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter checkpoints
.ipynb_checkpoints/

# Data lớn (không commit lên Git)
data/raw/
data/processed/
models/*.pth
models/*.pt

# MLflow
mlruns/
mlflow.db

# Large model weights
models/pretrained/
models/deep_learning/*.pth

# IDE
.vscode/settings.json
*.swp

# References (keep .docx local only)
references/*.docx

# Temp files
.tmp/

# Local caches redirected off C: drive (HF hub, torch hub, etc.)
.cache/

# Local secrets (HF token, etc.) — only the template is committed
.env

# Local runtime / logs / results — exclude by default
logs/
results/*
# ...but keep the canonical deep-learning evaluation outputs (metrics CSV/JSON,
# comparison tables, figures, qualitative samples) so readers can inspect them
# without re-running the GPU eval. Model weights stay ignored via the rules above.
!results/deep_learning/