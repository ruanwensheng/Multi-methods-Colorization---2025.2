# Project-local environment variables.
# Copy to .env (gitignored) and edit for your local setup.

# === Cache redirection ===
# Keep HuggingFace + Torch model caches on the project drive (D:) so they
# don't fill C: and crash training with WinError 1455 (paging file too small).
# Resolves to absolute paths at activation time.
HF_HOME=D:/Projects/Multi-methods-Colorization---2025.2/.cache/huggingface
TRANSFORMERS_CACHE=D:/Projects/Multi-methods-Colorization---2025.2/.cache/huggingface/hub
TORCH_HOME=D:/Projects/Multi-methods-Colorization---2025.2/.cache/torch

# pip caches are typically smaller and already settle; relocate only if needed:
# PIP_CACHE_DIR=D:/Projects/Multi-methods-Colorization---2025.2/.cache/pip

# === Secrets (do not commit) ===
# HF_TOKEN=hf_xxx_replace_me
